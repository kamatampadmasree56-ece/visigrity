# VISIGRITY Backend Environment Configuration

# ==========================================
# 1. DATABASE CONFIGURATION
# ==========================================
# For Production (Vercel Postgres, Neon, Supabase, Render):
# DATABASE_URL=postgresql://user:password@host:5432/visigrity
# For Local Development / SQLite:
DATABASE_URL=sqlite:///./visigrity.db
SQLITE_FALLBACK=true

# ==========================================
# 2. SECURITY & AUTHENTICATION (JWT)
# ==========================================
# Generate a secure 64-character random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-super-secret-key-in-production-visigrity-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# 3. CORS CONFIGURATION (Comma-separated)
# ==========================================
# Include your deployed Vercel frontend domain and local development URLs
# Do NOT use wildcard '*' when credentials/auth are enabled
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# ==========================================
# 4. APPLICATION ENVIRONMENT & MODES
# ==========================================
ENVIRONMENT=production
BLOCKCHAIN_MODE=DEMO
CV_ENGINE_MODE=DEMO
API_PREFIX=/api
