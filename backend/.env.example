# VISIGRITY Backend Environment Configuration

# Database Configuration (PostgreSQL with fallback to SQLite for local development)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/visigrity
SQLITE_FALLBACK=true

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-super-secret-key-in-production-visigrity-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment & Modes
ENVIRONMENT=development
BLOCKCHAIN_MODE=DEMO
API_PREFIX=/api
